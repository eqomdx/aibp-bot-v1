# Which LLM provider to use:
#   mock  - fixed example summary, no network calls, no credentials needed
#   azure - Azure OpenAI; needs the four Azure settings below
LLM_PROVIDER=mock

# --- Azure OpenAI (only read when LLM_PROVIDER=azure) ---

# Azure OpenAI resource endpoint
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI key
OPENAI_API_KEY=

# Azure OpenAI API version
OPENAI_API_VERSION=2024-12-01-preview

# Azure model deployment name
CHAT_MODEL=gpt-4.1-nano

# Reserved for later retrieval/Q&A functionality
EMBEDDING_MODEL=text-embedding-3-small
